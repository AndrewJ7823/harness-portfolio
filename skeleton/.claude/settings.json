{
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/*.pem)",
      "Read(~/.aws/credentials)",
      "Bash(cat *.env*)",
      "Bash(aws *secretsmanager get-secret-value*)",
      "Bash(aws *sns publish*)",
      "Bash(curl *hooks.slack.com*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/block-push-to-protected.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
